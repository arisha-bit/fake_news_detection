# Copy this file to .env and fill in real values.
# Never commit .env with real credentials.

# Use postgresql+psycopg:// (psycopg v3 driver — matches psycopg[binary] in requirements.txt)
# The host must be "db" (Docker service name), not "localhost"
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@db:5432/fakenews
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
