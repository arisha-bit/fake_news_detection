# ─── ML model files ───────────────────────────────────────────────────────────
# Ignore large HuggingFace/PyTorch artifacts that should not be committed
*.safetensors
*.bin

# Do NOT ignore best_image_model.pth or logistic/lstm/tfidf models
# They are required for the app to run and are tracked in git.
# If they are too large for git, use Git LFS.

# Ignore the unused duplicate image_classifier.pt (EfficientNet — not used)
backend/app/ml/saved_models/image_classifier.pt
backend/app/ml/saved_models/image_classifier_metrics.json

# Uploads (temp files — volume-managed in Docker)
backend/uploads/images/*
!backend/uploads/images/.gitkeep

# FAISS indexes (built at entrypoint from datasets — not committed)
backend/app/ml/embeddings/index/
backend/app/ml/clip/index/

# pytest cache
.pytest_cache/
backend/tests/__pycache__/
